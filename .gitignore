# ==============================
#  AI Project .gitignore
# ==============================

# Large model files
ai-engine/models_onnx/
*.onnx
*.safetensors
*.pt
*.bin
*.joblib
*.pkl

# Python cache & virtual envs
__pycache__/
*.pyc
.venv/

# Environment files with secrets (any folder)
.env
.env.*
!.env.example

# Node.js dependencies
node_modules/

# Build / dist folders
build/
dist/

# IDE / system files
.vscode/
.idea/
*.log
.DS_Store
